# ============================================
#  MOBPOS — متغيرات بيئة البناء
#  انسخ هذا الملف إلى .env.local (متجاهَل في Git)
#  واملأ القيم على جهاز البناء فقط. لا ترفع .env.local أبداً.
# ============================================

# رابط سيرفر التفعيل (اختياري؛ القيمة الافتراضية مضمّنة في الكود)
VITE_ACTIVATION_SERVER_URL=https://mobpos-7ea73.containers.snapdeploy.app

# توكن عميل سيرفر التفعيل — يطابق ACTIVATION_TOKEN على السيرفر.
# إلزامي عند البناء لو سيرفر التفعيل مفعّل، وإلا سيرفض السيرفر
# طلبات /activate و /verify. (أُزيلت القيمة المثبّتة القديمة من
# المستودع لأنها كانت مكشوفة — دوّرها على السيرفر وضع الجديدة هنا.)
VITE_ACTIVATION_SERVER_TOKEN=

# Supabase (اختياري — للمزامنة السحابية الافتراضية)
VITE_DEFAULT_SUPABASE_URL=
VITE_DEFAULT_SUPABASE_ANON_KEY=
