{
  "name": "mobpos",
  "productName": "MOBPOS",
  "private": true,
  "version": "1.0.8",
  "description": "نظام إدارة محلات الموبايلات — MOBPOS Management System",
  "author": "MOBPOS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/utils/alerts.test.ts src/utils/barcode.test.ts src/license/status.test.ts src/utils/updateCheck.test.ts src/hooks/storeDiff.test.ts src/hooks/atomicTransaction.test.ts src/utils/format.test.ts src/utils/salesByCategory.test.ts",
    "verify:updates": "node scripts/verify-update-feed.cjs",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.cjs",
    "setup:ci": "node scripts/install-workflow.cjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:publish": "npm run build && electron-builder --win --x64 --publish always",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@types/uuid": "^10.0.0",
    "clsx": "2.1.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
